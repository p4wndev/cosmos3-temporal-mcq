# Environment variables used by this project.
#
# Copy to `.env` and fill in if you need them, then export before running:
#   set -a; . ./.env; set +a
#
# NEVER commit a real value. `.env` is git-ignored; this example file is not.
#
# The source dataset (nvidia/BridgeData2-Subset-Synthetic-Captions) is public
# and ungated, so NO token is required to run this pipeline. HF_TOKEN is read
# from the environment only if it is already set, and its value is never
# printed, logged, or written to disk.

# Optional. Only needed if you hit rate limits or access a gated resource.
HF_TOKEN=

# Optional alias some tooling expects; leave empty unless you use it.
HUGGINGFACE_TOKEN=

# Not used by the dataset-preparation pipeline. Reserved for future GPU
# experiments that pull NGC containers; do not set until needed.
NGC_API_KEY=
