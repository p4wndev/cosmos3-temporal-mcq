# ---------------------------------------------------------------------------
# Source dataset and derived media — NOT redistributable in this repository.
# See docs/dataset_provenance.md. Redistribution rights are unresolved, so raw
# videos, the prepared video trees, full annotations, caption extracts and
# contact sheets are all kept out of version control.
# ---------------------------------------------------------------------------
data/
bridgedata2_temporal_mcq/*/videos/
bridgedata2_temporal_mcq/manifests/
bridgedata2_temporal_mcq/*/annotations.json
bridgedata2_temporal_mcq/reports/
# The dataset tree is a generated artifact. Its own README is a build byproduct
# that names individual source clips; the root README documents the dataset.
bridgedata2_temporal_mcq/README.md
reports/contact_sheets/
reports/*.log

# Human review decisions: a local record of human judgement over source-derived
# material, kept out of version control like the annotations themselves.
reports/review_decisions.jsonl
reports/review_summary.*
reports/review_decisions*.jsonl

# Materialized dataset releases.  These are derived from source captions and
# video metadata (and reference source clips by id), so they carry the same
# unresolved redistribution question as the annotations.  Kept local; never
# committed.  Rebuild with `python -m temporal_mcq materialize`.
releases/

# Generated media of any kind
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.jpg
*.jpeg
*.png

